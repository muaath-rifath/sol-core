# Copy this file to .env before running Docker Compose. Values marked REQUIRED
# must be supplied for the corresponding feature to work.

# Core services (the Compose stack provides PostgreSQL, Redis, MinIO, and VerneMQ).
DATABASE_URL=postgres://sol:sol@postgres:5432/sol?sslmode=disable
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=firmware
MQTT_BROKER_URL=tcp://vernemq:1883
MQTT_CLIENT_ID=sol-backend

# REQUIRED: the core uses this CA to issue device certificates. Compose creates
# a local CA at these paths automatically.
CA_CERT_PATH=/certs/ca.crt
CA_KEY_PATH=/certs/ca.key

# Local-only authentication: makes a fresh checkout usable without Zitadel.
# Never enable these values in a shared or production environment.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=sol-local-development-token-change-before-sharing
AUTH_DEV_MODE=true
AUTH_DEV_TOKEN=sol-local-development-token-change-before-sharing

# Required only when AUTH_DEV_MODE and DEV_AUTH_ENABLED are both false.
OIDC_ISSUER=https://your-tenant.zitadel.cloud
AUTH_ZITADEL_ID=replace-with-zitadel-client-id
AUTH_ZITADEL_SECRET=replace-with-zitadel-client-secret
AUTH_ZITADEL_ISSUER=https://your-tenant.zitadel.cloud
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Internal service-to-service authentication. REQUIRED when builder or voice
# agent services are enabled.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-secret

# Public URLs used by invitation links and OTA metadata.
FRONTEND_URL=http://localhost:3000
SOL_CORE_URL=http://sol-core:8080
AUTH_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
OTA_API_URL=https://ota.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Optional chat and semantic appliance discovery.
AI_SERVICE_URL=http://localhost:8000
KIMI_ENDPOINT=
KIMI_API_KEY=
KIMI_DEPLOYMENT=Kimi-K2.6
COHERE_AZURE_ENDPOINT=
COHERE_AZURE_KEY=
COHERE_AZURE_DEPLOYMENT=embed-v4-0
COHERE_API_VERSION=2024-05-01-preview

# Optional invitation email delivery.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Sol

# Required only for the optional voice profile: docker compose --profile voice up.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_DEPLOYMENT=
AZURE_API_VERSION=2024-10-01-preview
