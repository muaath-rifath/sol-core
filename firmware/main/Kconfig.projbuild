menu "Smart Home Demo Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "MyNetwork"

    config WIFI_PASSWORD
        string "WiFi Password"
        default "MyPassword"

    config MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://192.168.1.100:1883"

    config MQTT_USERNAME
        string "MQTT Username"
        default ""

    config MQTT_PASSWORD
        string "MQTT Password"
        default ""

    config DEVICE_ID
        string "Device ID"
        default "esp32-led-001"

    config VOICE_MIC_PEAK_LOG
        bool "Log mic peak amplitude every ~2 s (audio debug)"
        default n
        help
          When enabled, afe_feed_task prints the peak int16 sample value
          from each ~2-second window. Useful for verifying the INMP441 mic
          is producing audio before wake-word testing. Disable for production.

endmenu
